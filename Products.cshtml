@page
@model AjouhaarSalesStockWebsite.Pages.IndexModel
@{
    Layout = "_AppLayout";
    Model.View = "Products";
    ViewData["Title"] = "Products";
}

@if (Model.View.Equals("Products", StringComparison.OrdinalIgnoreCase))
{
    <div class="full-page-panel">
        @if (Model.ActiveUserRole == "Manager")
        {
            <article class="panel product-form-panel">
                <div class="panel-heading">
                    <h3>Add new product</h3>
                </div>

                <form method="post" asp-page-handler="SaveProduct" asp-route-view="Products" class="product-form-grid">
                    <input asp-for="ProductForm.ProductID" type="hidden" value="0">

                    <div>
                        <label asp-for="ProductForm.ProductName">Product name</label>
                        <input asp-for="ProductForm.ProductName" placeholder="Enter product name" required>
                    </div>

                    <div>
                        <label asp-for="ProductForm.Category">Category</label>
                        <input asp-for="ProductForm.Category" placeholder="Beef, Lamb, Poultry..." required>
                    </div>

                    <div>
                        <label asp-for="ProductForm.UnitPrice">Price per kg</label>
                        <input asp-for="ProductForm.UnitPrice" type="number" min="0.01" step="0.01" required>
                    </div>

                    <div>
                        <label asp-for="ProductForm.QuantityOnHand">Quantity on hand (kg)</label>
                        <input asp-for="ProductForm.QuantityOnHand" type="number" min="0" step="0.1" required>
                    </div>

                    <div>
                        <label asp-for="ProductForm.ReorderLevel">Reorder level (kg)</label>
                        <input asp-for="ProductForm.ReorderLevel" type="number" min="0" step="0.1" required>
                    </div>

                    <label class="toggle-line product-active-toggle">
                        <input asp-for="ProductForm.IsActive" type="checkbox" checked>
                        Active product
                    </label>

                    <button class="primary-action" type="submit">Add product</button>
                </form>
            </article>
        }

        <article class="panel">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>ID</th><th>Product</th><th>Category</th><th>Price per kg</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td>@product.ProductID</td>
                                <td>@product.ProductName</td>
                                <td>@product.Category</td>
                                <td>@Model.Money(product.UnitPrice)</td>
                                <td>
                                    @if (Model.ActiveUserRole == "Manager")
                                    {
                                        <form method="post" asp-page-handler="UpdateProductStatus" asp-route-view="Products" class="status-form">
                                            <input type="hidden" name="productID" value="@product.ProductID">
                                            <select name="isActive" onchange="this.form.submit()" aria-label="Status for @product.ProductName">
                                                <option value="true" selected="@product.IsActive">Active</option>
                                                <option value="false" selected="@(!product.IsActive)">Inactive</option>
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="status-pill @(product.IsActive ? "" : "inactive")">@(product.IsActive ? "Active" : "Inactive")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    </div>
}

